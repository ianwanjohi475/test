# ── Copy to .env and fill in. `make up` brings the whole system to life. ──

# Your dashboard domain (DNS A record → this VPS). Caddy auto-provisions HTTPS.
DOMAIN=pbx.example.co.ke
PUBLIC_URL=https://pbx.example.co.ke

# Postgres
POSTGRES_PASSWORD=

# Auth
JWT_SECRET=
ADMIN_EMAIL=you@example.co.ke
ADMIN_PASSWORD=
ADMIN_NAME=Ian Wanjohi

# SIP / FreeSWITCH
SIP_DOMAIN=pbx.example.co.ke
SIP_WSS_URL=wss://sip.pbx.example.co.ke
FS_ESL_PASSWORD=ClueCon-CHANGE-ME

# SIP trunk (optional — Telnyx / DIDWW / Safaricom SIP; leave blank if using
# Africa's Talking Voice API only)
TRUNK_USERNAME=
TRUNK_PASSWORD=
TRUNK_REALM=
TRUNK_PROXY=

# Africa's Talking — https://account.africastalking.com (sandbox is free)
AT_USERNAME=sandbox
AT_API_KEY=
AT_VOICE_NUMBER=+254709100100
AT_SMS_SENDER_ID=

# Safaricom Daraja (M-Pesa) — https://developer.safaricom.co.ke (sandbox free)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Anthropic — powers Zuri, call summaries, voicemail urgency
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Security
ALLOW_INTERNATIONAL=false
INTL_ALLOWLIST=
MAX_OUTBOUND_PER_HOUR=60
