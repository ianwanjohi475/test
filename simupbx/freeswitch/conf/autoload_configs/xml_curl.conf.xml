<!-- Directory lookups come from the SimuPBX API (Postgres-backed), so
     creating a user in the dashboard instantly provisions their extension. -->
<configuration name="xml_curl.conf" description="XML Curl">
  <bindings>
    <binding name="simupbx-directory">
      <param name="gateway-url" value="http://api:4000/webhooks/fs/xml" bindings="directory"/>
    </binding>
  </bindings>
</configuration>
