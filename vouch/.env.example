# ── Vouch environment ────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Never commit real values.
# Only NEXT_PUBLIC_* vars are exposed to the browser — keep everything else
# server-side. Not every var is needed until its phase lands (see README).

# App
# Public base URL of the app (used to build review links). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Supabase (Phase 2) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Resend email (Phase 3) ───────────────────────────────────────────────────
RESEND_API_KEY=""
# Verified sending domain address, e.g. "requests@mail.yourdomain.com"
RESEND_FROM_EMAIL=""

# ── Stripe billing (Phase 5) ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
# From the Stripe CLI / dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=""
# The single paid plan's recurring price id (price_...).
STRIPE_PRICE_ID=""
